# Copy this file to `.env` and fill in your real environment values.
# Do NOT commit real credentials - .env is gitignored.

# Base URL of the application under test.
BASE_URL=https://zincbank.cydeo.io/login

# Browser to run against: chromium | firefox | webkit
BROWSER=chromium

# Run headless (true) or headed (false).
HEADLESS=true

# Application login credentials (provided by the test lead / team).
VALID_USERNAME=your_test_email
VALID_PASSWORD=your_test_password

# zincTM practice site.
ZINCTM_BASE_URL=https://zinctm.cydeo.io
ZINCTM_USERNAME=
ZINCTM_PASSWORD=
