{
  "name": "zinc-bank-framework",
  "version": "1.0.0",
  "description": "Playwright + Cucumber.js + TypeScript UI automation framework using the Page Object Model",
  "private": true,
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:chromium": "cross-env BROWSER=chromium cucumber-js",
    "test:feature": "cucumber-js",
    "test:tag": "cucumber-js --tags",
    "typecheck": "tsc --noEmit",
    "report": "echo \"HTML report: reports/cucumber-report.html\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/html-formatter": "^24.1.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  }
}
